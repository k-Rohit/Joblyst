# Joblyst — environment configuration.
# Copy to `.env` and fill in real values. `.env` is already git-ignored — never
# commit it.
#
# NOTE: put values directly after `=` with nothing else on the line. Don't add
# inline `# comments` after a value on the same line.

# --- LLM ----------------------------------------------------------------
# https://platform.openai.com/api-keys (needs a card on file; gpt-4o-mini is
# a fraction of a cent per call).
OPENAI_API_KEY=

# --- Opik observability (tracing every LLM call) -------------------------
# Free account: https://www.comet.com/
OPIK_API_KEY=
# Leave empty to use your API key's default workspace.
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=joblyst
OPIK_ENABLED=true
