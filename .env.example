# Joblyst — environment configuration.
# Copy to `.env` and fill in real values. `.env` is already git-ignored — never
# commit it.
#
# NOTE: put values directly after `=` with nothing else on the line. Don't add
# inline `# comments` after a value on the same line.

# --- LLM ----------------------------------------------------------------
# https://platform.openai.com/api-keys (needs a card on file; gpt-4o-mini is
# a fraction of a cent per call).
OPENAI_API_KEY=

# Model that judges tailored CVs for fabrication. Keep it stronger than the
# model that writes them.
JOBLYST_JUDGE_MODEL=openai:gpt-4.1

# --- Opik: prompts, tracing and evals (REQUIRED) ---------------------------
# The app reads its prompts from Opik's prompt library, so it will not start
# without this. Free account: https://www.comet.com/
# First time with a new account: uv run python scripts/seed_prompts.py --yes
OPIK_API_KEY=
# Leave empty to use your API key's default workspace.
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=joblyst
OPIK_ENABLED=true

# --- Job sources (all optional) -------------------------------------------
# Each source is skipped when its key is empty. Remotive and Himalayas need no
# key, and an offline snapshot is the last resort, so search always returns
# something. More keys = more and better jobs.
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch (RapidAPI): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Jooble:
# IMPORTANT: a Jooble key is region-locked to the domain you registered on.
# A key from jooble.org only searches US listings and returns 403 on
# in.jooble.org's endpoint (confirmed). For India results, register at
# https://in.jooble.org/api/about, and set JOOBLE_BASE_URL to match:
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://in.jooble.org/api

# --- Search / ranking knobs ------------------------------------------------
# Jobs fetched per search call (default 10). More jobs = more rank_jobs
# batches = slower ranking, since each batch is its own LLM call.
JOBLYST_MAX_JOBS=10
# Jobs scored per ranking LLM call (default 4). Batches run in parallel, so
# a smaller batch size lowers the slowest-batch latency at the cost of a few
# more LLM calls overall.
JOBLYST_RANK_BATCH=4

# --- Company research for cover letters (optional) -------------------------
# https://tavily.com/ — skipped when empty.
TAVILY_API_KEY=

# --- Database (optional) ---------------------------------------------------
# Without it, sessions and search results live in the server's memory and are
# lost on restart. With it, they are stored in Postgres and survive restarts.
# Supabase: use the SESSION POOLER string (port 5432). Use a password with only
# letters and digits: characters like @ break the URL. Run schema.sql once.
DATABASE_URL=

# --- Frontend addresses allowed to call the API ----------------------------
# A JSON list. Default: ["http://localhost:3000"]. Add your deployed URL.
# CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
